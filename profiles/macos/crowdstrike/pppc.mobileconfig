<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CrowdStrike Falcon — PPPC / Privacy Preferences Policy Control Profile
  Purpose: Grants Full Disk Access and required privacy entitlements to
           CrowdStrike Falcon so macOS does not prompt users for permissions.

  IMPORTANT:
  1. Deploy this profile BEFORE installing CrowdStrike Falcon.
  2. Generate fresh PayloadUUID values using `uuidgen` before production deployment.

  CrowdStrike Bundle IDs:
    - com.crowdstrike.falcon.agent   (Falcon agent — requires FDA)
    - com.crowdstrike.falcon.App     (Falcon UI app)
  Team ID: X9E956P446 (CrowdStrike Inc.)
  Tested on: macOS 13 Ventura, 14 Sonoma, 15 Sequoia
-->
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadType</key>
      <string>com.apple.TCC.configuration-profile-policy</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>PayloadIdentifier</key>
      <string>com.mdm-installers.crowdstrike.pppc</string>
      <key>PayloadUUID</key>
      <string>C9D0E1F2-A3B4-5678-2345-789012345678</string>
      <key>PayloadDisplayName</key>
      <string>CrowdStrike Falcon PPPC Permissions</string>
      <key>PayloadDescription</key>
      <string>Grants Full Disk Access to CrowdStrike Falcon agent and app.</string>
      <key>Services</key>
      <dict>
        <key>SystemPolicyAllFiles</key>
        <array>
          <!-- Falcon Agent (requires Full Disk Access) -->
          <dict>
            <key>Allowed</key>
            <true/>
            <key>CodeRequirement</key>
            <string>anchor apple generic and identifier "com.crowdstrike.falcon.agent" and (certificate leaf[field.1.2.840.113635.100.6.1.9] /* exists */ or certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "X9E956P446")</string>
            <key>Comment</key>
            <string>CrowdStrike Falcon agent daemon</string>
            <key>Identifier</key>
            <string>com.crowdstrike.falcon.agent</string>
            <key>IdentifierType</key>
            <string>bundleID</string>
          </dict>
          <!-- Falcon UI App -->
          <dict>
            <key>Allowed</key>
            <true/>
            <key>CodeRequirement</key>
            <string>anchor apple generic and identifier "com.crowdstrike.falcon.App" and (certificate leaf[field.1.2.840.113635.100.6.1.9] /* exists */ or certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "X9E956P446")</string>
            <key>Comment</key>
            <string>CrowdStrike Falcon app</string>
            <key>Identifier</key>
            <string>com.crowdstrike.falcon.App</string>
            <key>IdentifierType</key>
            <string>bundleID</string>
          </dict>
        </array>
      </dict>
    </dict>
  </array>
  <key>PayloadDisplayName</key>
  <string>CrowdStrike Falcon — Privacy Preferences (PPPC)</string>
  <key>PayloadDescription</key>
  <string>Grants Full Disk Access to CrowdStrike Falcon. Deploy before installing the agent.</string>
  <key>PayloadIdentifier</key>
  <string>com.mdm-installers.crowdstrike.pppc.profile</string>
  <key>PayloadOrganization</key>
  <string>Your Organization Name</string>
  <key>PayloadScope</key>
  <string>System</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>D0E1F2A3-B4C5-6789-3456-890123456789</string>
  <key>PayloadVersion</key>
  <integer>1</integer>
</dict>
</plist>
